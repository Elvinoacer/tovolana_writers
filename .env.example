# ==============================================================================
# Tovolana Writers — Online Writing Platform Environment Variables (.env.example)
# Copy this file to .env (local) or configure in Vercel Project Settings.
# Never commit .env or .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Cache (Neon PostgreSQL / Local PostgreSQL & Redis / Upstash)
# ------------------------------------------------------------------------------
# Pooled connection string (used at runtime by @prisma/adapter-pg)
DATABASE_URL="postgresql://localhost:5432/tovolana_writers?schema=public"
# Direct / unpooled connection string (used by Prisma CLI migrations)
DIRECT_URL="postgresql://localhost:5432/tovolana_writers?schema=public"
# Local / TCP Redis URL (used for rate limiting, distributed checkout locks, & caching)
REDIS_URL="redis://127.0.0.1:6379"
# Optional Upstash Redis REST credentials (for Serverless / Edge production deployments)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 2. Application & Authentication (Session + Native Email/Password + Google OAuth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Cryptographically random 32+ byte secret for HMAC session & token signing
# Generate with: env-ops gen-secret AUTH_SECRET
AUTH_SECRET="replace-with-32-byte-secret"
SESSION_COOKIE_NAME="tovolana_session"

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 3. Payments — IntaSend (M-Pesa STK Push, Card Checkout, Webhooks)
# ------------------------------------------------------------------------------
# Obtain from IntaSend Sandbox/Live Dashboard -> Developers -> API Keys
INTASEND_PUBLISHABLE_KEY=""
INTASEND_SECRET_KEY=""
# Keep "true" for sandbox testing; set to "false" ONLY after Stage 7 QA passes
INTASEND_IS_TEST="true"
# Secret challenge configured in IntaSend Webhook Settings (verified via timingSafeEqual)
# Generate with: env-ops gen-secret INTASEND_WEBHOOK_CHALLENGE
INTASEND_WEBHOOK_CHALLENGE="replace-with-intasend-webhook-challenge"

# ------------------------------------------------------------------------------
# 4. Firebase (FCM Push Notifications & Client Web Push)
# ------------------------------------------------------------------------------
# Firebase Admin SDK (Service Account credentials for server-side push dispatch)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Replace newlines with \n when pasting the private key in a single line
FIREBASE_PRIVATE_KEY=""

# Firebase Web Client Config (Public SDK keys for browser FCM token registration)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ------------------------------------------------------------------------------
# 5. Transactional Email & SMS OTP Notifications
# ------------------------------------------------------------------------------
# Resend API (preferred) or standard SMTP fallback
RESEND_API_KEY=""
EMAIL_FROM="Tovolana Writers <noreply@tovolana.example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# SMS Provider (e.g., Africa's Talking / Twilio / IntaSend SMS for Phone OTP)
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID="TOVOLANA"

# ------------------------------------------------------------------------------
# 6. Private File Storage & Scheduled Background Cron Workers
# ------------------------------------------------------------------------------
# HMAC secret for short-lived signed upload/download URLs (never expose publicly)
# Generate with: env-ops gen-secret STORAGE_SIGNING_SECRET
STORAGE_SIGNING_SECRET="replace-with-storage-signing-secret"
# Optional remote object storage / S3 / Vercel Blob URL (defaults to local private ./uploads)
STORAGE_BUCKET_URL=""
# Authorization bearer secret for Vercel Cron / scheduled jobs (/api/cron/*)
# Generate with: env-ops gen-secret CRON_SECRET
CRON_SECRET="replace-with-cron-secret"
